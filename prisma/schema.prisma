generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Level {
  FEDERAL
  STATEWIDE
  LEGISLATURE
  JUDICIAL
}

enum Party {
  R
  D
  N
}

enum Source {
  FEC
  MT_COPP
  PLACEHOLDER
}

model Politician {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  sortName       String         @default("")
  office         String
  level          Level
  party          Party
  cycle          Int
  source         Source
  fecCandidateId String?        @unique
  coppCandidateId String?       @unique
  totalRaised    Decimal        @db.Decimal(14, 2)
  cashOnHand     Decimal        @db.Decimal(14, 2)
  // False only when ingest-copp.ts finds a candidate with no filed
  // reports at all: totalRaised/cashOnHand are then a real 0, not "we
  // don't know," but there's nothing behind that 0 to distinguish it
  // from a candidate who filed and genuinely reported zero. FEC-sourced
  // rows never set this false: ingest-fec.ts already skips a candidate
  // entirely when OpenFEC has no totals record for the cycle, so every
  // FEC row's totalRaised is backed by a real filing already.
  hasFilings     Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  contributions  Contribution[]
  independentExpenditures IndependentExpenditure[]

  @@index([level])
}

model Donor {
  id                   String         @id @default(cuid())
  slug                 String         @unique
  name                 String
  employer             String?
  occupation           String?
  city                 String
  state                String
  sector               String
  // Populated best-effort for FEC-sourced PAC/committee donors from FEC's
  // own /committee/{id} record: never inferred or written by us, so a
  // null value here just means we haven't looked it up (yet), not that
  // there's nothing to know.
  fecCommitteeId       String?
  committeeDesignation String?
  committeeType        String?
  committeeOrgType     String?
  registeredSince      DateTime?
  // For joint fundraising committees only: the other committees that share
  // in its proceeds, derived from its own Schedule B transfer disbursements
  // (never inferred): an array of { committeeId, name, amount }.
  jfcParticipants      Json?
  contributions        Contribution[]
  independentExpenditures IndependentExpenditure[]
  ballotMeasureExpenditures BallotMeasureExpenditure[]
  fundingReceived      CommitteeFunding[] @relation("CommitteeFundingRecipient")
  fundingGiven         CommitteeFunding[] @relation("CommitteeFundingFunder")

  @@index([sector])
  @@index([state])
}

model Contribution {
  id           String     @id @default(cuid())
  politicianId String
  donorId      String
  amount       Decimal    @db.Decimal(12, 2)
  date         DateTime
  note         String?
  isPac        Boolean
  politician   Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  donor        Donor      @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@index([politicianId])
  @@index([donorId])
}

// Money a Super PAC (or other "independent expenditure-only" committee)
// spends supporting or opposing a candidate; legally distinct from a
// Contribution: this money is never given to the candidate's own
// committee (that's the whole point of "independent": no coordination),
// it's paid directly to a vendor (ad buys, mailers, etc.) on the
// candidate's behalf. Sourced from FEC Schedule E, not Schedule A.
model IndependentExpenditure {
  id           String     @id @default(cuid())
  politicianId String
  donorId      String
  amount       Decimal    @db.Decimal(12, 2)
  date         DateTime
  // null = the filing never clearly said support or oppose (only possible
  // for MT_COPP rows, whose source filings have no structured indicator
  // and are read from free text; FEC always reports this explicitly).
  support      Boolean?
  description  String?
  payee        String?
  politician   Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  donor        Donor      @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@index([politicianId])
  @@index([donorId])
}

// A Montana statewide ballot measure (Constitutional Initiative,
// statutory Initiative, or Legislative Referendum), identified only by
// its official code (e.g. "LR-130", "CI-128", "I-190"). MT_COPP only:
// deliberately scoped to measures with a real assigned code, never a
// locally-invented name, since a local levy or bond is filed as free
// text with no canonical form (the same measure shows up phrased three
// or four different ways across filings) and there is no registry to
// resolve that against; fabricating one canonical spelling would just be
// a guess. Those stay out of this table entirely rather than risk being
// counted as several different fake measures.
model BallotMeasure {
  id                      String                     @id @default(cuid())
  slug                    String                     @unique
  // Normalized display form, e.g. "LR-130". Same value the slug derives
  // from; kept separate so the slug's own format (lowercase, URL-safe)
  // never has to leak into anywhere the code is actually displayed.
  code                    String                     @unique
  independentExpenditures BallotMeasureExpenditure[]
}

// Same shape as IndependentExpenditure, just aimed at a ballot measure
// instead of a candidate; see BallotMeasure for why this only exists for
// measures with a real assigned code.
model BallotMeasureExpenditure {
  id              String        @id @default(cuid())
  ballotMeasureId String
  donorId         String
  amount          Decimal       @db.Decimal(12, 2)
  date            DateTime
  support         Boolean?
  description     String?
  payee           String?
  ballotMeasure   BallotMeasure @relation(fields: [ballotMeasureId], references: [id], onDelete: Cascade)
  donor           Donor         @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@index([ballotMeasureId])
  @@index([donorId])
}

// Money a committee itself received, read off its own C-6 report's
// "Contributions" schedules (MT_COPP only, read straight from the
// portal's Individual and Committee contributor tables, never inferred).
// This is what lets a committee's spending be checked against its
// disclosed funding: a committee with independent expenditures but no
// CommitteeFunding rows to cover them is exactly what dark money looks
// like from the outside: COPP recorded where the money went but never
// where it came from.
model CommitteeFunding {
  id          String   @id @default(cuid())
  committeeId String
  funderName  String
  funderCity  String
  funderState String
  // "Individual", or the committee-type label COPP itself gives the
  // contributing committee (e.g. "Incidental Committee Contributions"):
  // read straight off the report's own column, never a guess.
  funderType  String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime
  // Set only when the funder itself resolved to a committee we already
  // track (via ingest-copp-ie.ts's by-name committee search), so the
  // donor page can link straight to that committee's own page instead of
  // showing plain text; null just means we haven't matched it, not that
  // it isn't a committee. Never set for an individual funder.
  funderDonorId String?
  committee   Donor    @relation("CommitteeFundingRecipient", fields: [committeeId], references: [id], onDelete: Cascade)
  funderDonor Donor?   @relation("CommitteeFundingFunder", fields: [funderDonorId], references: [id], onDelete: SetNull)

  @@index([committeeId])
  @@index([funderDonorId])
}
