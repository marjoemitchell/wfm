generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Level {
  FEDERAL
  STATEWIDE
  LEGISLATURE
  JUDICIAL
}

enum Party {
  R
  D
  N
}

enum Source {
  FEC
  MT_COPP
  PLACEHOLDER
}

model Politician {
  id             String         @id @default(cuid())
  slug           String         @unique
  name           String
  sortName       String         @default("")
  office         String
  level          Level
  party          Party
  cycle          Int
  source         Source
  fecCandidateId String?        @unique
  coppCandidateId String?       @unique
  totalRaised    Decimal        @db.Decimal(14, 2)
  cashOnHand     Decimal        @db.Decimal(14, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  contributions  Contribution[]

  @@index([level])
}

model Donor {
  id                   String         @id @default(cuid())
  slug                 String         @unique
  name                 String
  employer             String?
  occupation           String?
  city                 String
  state                String
  sector               String
  // Populated best-effort for FEC-sourced PAC/committee donors from FEC's
  // own /committee/{id} record — never inferred or written by us, so a
  // null value here just means we haven't looked it up (yet), not that
  // there's nothing to know.
  fecCommitteeId       String?
  committeeDesignation String?
  committeeOrgType     String?
  registeredSince      DateTime?
  // For joint fundraising committees only: the other committees that share
  // in its proceeds, derived from its own Schedule B transfer disbursements
  // (never inferred) — an array of { committeeId, name, amount }.
  jfcParticipants      Json?
  contributions        Contribution[]

  @@index([sector])
  @@index([state])
}

model Contribution {
  id           String     @id @default(cuid())
  politicianId String
  donorId      String
  amount       Decimal    @db.Decimal(12, 2)
  date         DateTime
  note         String?
  isPac        Boolean
  politician   Politician @relation(fields: [politicianId], references: [id], onDelete: Cascade)
  donor        Donor      @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@index([politicianId])
  @@index([donorId])
}
